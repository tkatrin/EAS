{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eas.example/schemas/eas-run/0.1.0",
  "title": "EAS 0.1 Experimental Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eas_version",
    "schema_version",
    "run_id",
    "implementation",
    "environment",
    "started_at",
    "completed_at",
    "record_created_at",
    "task",
    "initial_state",
    "constraints",
    "state_history",
    "actions",
    "decisions",
    "evidence",
    "final_state",
    "outcome",
    "task_result",
    "report",
    "mapping"
  ],
  "properties": {
    "eas_version": { "const": "0.1" },
    "schema_version": { "const": "0.1.0" },
    "run_id": { "$ref": "#/$defs/nonEmptyString" },
    "predecessor_run_id": { "$ref": "#/$defs/nonEmptyString" },
    "implementation": { "$ref": "#/$defs/implementation" },
    "environment": { "$ref": "#/$defs/environment" },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "completed_at": { "$ref": "#/$defs/timestamp" },
    "record_created_at": { "$ref": "#/$defs/timestamp" },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description", "primary_class", "secondary_classes",
        "candidate_classes", "classification_basis", "acceptance_criteria"
      ],
      "properties": {
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "primary_class": {
          "enum": ["change", "diagnose", "review", "research", "operate", "advise"]
        },
        "secondary_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["change", "diagnose", "review", "research", "operate", "advise"] }
        },
        "candidate_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["change", "diagnose", "review", "research", "operate", "advise"] }
        },
        "classification_basis": { "$ref": "#/$defs/nonEmptyString" },
        "acceptance_criteria": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "initial_state": { "$ref": "#/$defs/projectState" },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "assumptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "state_history": {
      "type": "array",
      "minItems": 2,
      "items": {
        "enum": [
          "RECEIVED", "UNDERSTANDING", "PLANNING", "EXECUTING",
          "VERIFYING", "REVIEWING", "REPORTING", "ESCALATED",
          "BLOCKED", "COMPLETED"
        ]
      }
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "final_state": { "$ref": "#/$defs/projectState" },
    "outcome": { "enum": ["completed", "escalated", "blocked"] },
    "task_result": {
      "enum": ["satisfied", "partially_satisfied", "not_satisfied", "indeterminate"]
    },
    "report": { "$ref": "#/$defs/report" },
    "mapping": { "$ref": "#/$defs/mapping" },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(?:\\.[a-z0-9-]+)+$" },
      "additionalProperties": true
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "adapter", "adapter_version"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "adapter": { "$ref": "#/$defs/nonEmptyString" },
        "adapter_version": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "revision": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "projectState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "revision"],
      "properties": {
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "revision": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "description", "material", "materiality", "authority", "evidence_refs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "material": { "type": "boolean" },
        "materiality": { "$ref": "#/$defs/materiality" },
        "authority": { "enum": ["authorized", "escalated", "prohibited"] },
        "decision_id": { "$ref": "#/$defs/nonEmptyString" },
        "evidence_refs": { "$ref": "#/$defs/stringArray" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "question", "options", "choice", "disposition", "basis", "risk",
        "reversibility", "authority", "evidence_refs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "question": { "$ref": "#/$defs/nonEmptyString" },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "choice": { "$ref": "#/$defs/nonEmptyString" },
        "disposition": { "enum": ["inspect", "proceed", "escalate", "block", "refuse"] },
        "basis": { "$ref": "#/$defs/nonEmptyString" },
        "risk": { "enum": ["low", "medium", "high", "critical"] },
        "impact_level": { "enum": ["low", "medium", "high", "critical"] },
        "impact_scope": { "enum": ["local", "project", "external"] },
        "external_visibility": { "enum": ["none", "internal", "public"] },
        "destructiveness": { "enum": ["none", "modifying", "destructive"] },
        "data_sensitivity": { "enum": ["none", "internal", "confidential", "restricted"] },
        "rollback_available": { "type": "boolean" },
        "rollback_verified": { "type": "boolean" },
        "rollback_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "reversibility": { "$ref": "#/$defs/reversibility" },
        "authority": { "enum": ["authorized", "escalated", "prohibited"] },
        "authorization_source": { "$ref": "#/$defs/nonEmptyString" },
        "authorization_scope": { "$ref": "#/$defs/authorizationScope" },
        "authority_evidence_refs": { "$ref": "#/$defs/stringArray" },
        "evidence_refs": { "$ref": "#/$defs/stringArray" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "rollback_verified": { "const": true } },
            "required": ["rollback_verified"]
          },
          "then": { "required": ["rollback_evidence_refs"] }
        },
        {
          "if": {
            "properties": {
              "reversibility": {
                "properties": { "level": { "enum": ["full", "partial"] } },
                "required": ["level"]
              }
            },
            "required": ["reversibility", "rollback_available"]
          },
          "then": {
            "properties": { "rollback_available": { "const": true } }
          }
        },
        {
          "if": {
            "properties": {
              "reversibility": {
                "properties": { "level": { "const": "none" } },
                "required": ["level"]
              }
            },
            "required": ["reversibility", "rollback_available"]
          },
          "then": {
            "properties": { "rollback_available": { "const": false } }
          }
        },
        {
          "if": {
            "properties": { "rollback_verified": { "const": true } },
            "required": ["rollback_verified"]
          },
          "then": {
            "required": ["rollback_available"],
            "properties": { "rollback_available": { "const": true } }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "description", "result", "source", "origin", "capture",
        "observed_at", "recorded_at"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["inspection", "test", "analysis", "user", "tool", "artifact"] },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "result": { "enum": ["passed", "failed", "observed", "not_run", "inconclusive"] },
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "origin": { "enum": ["agent", "user", "tool", "environment", "assessor"] },
        "capture": { "enum": ["direct", "self_reported", "imported"] },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "recorded_at": { "$ref": "#/$defs/timestamp" },
        "artifact_ref": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "verificationClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "status", "evidence_refs"],
      "properties": {
        "claim": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "enum": ["passed", "failed", "not_run", "inconclusive"] },
        "evidence_refs": { "$ref": "#/$defs/stringArray" }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary", "changes", "verification", "limitations", "unresolved"
      ],
      "properties": {
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "changes": { "$ref": "#/$defs/stringArray" },
        "verification": {
          "type": "array",
          "items": { "$ref": "#/$defs/verificationClaim" }
        },
        "limitations": { "$ref": "#/$defs/stringArray" },
        "unresolved": { "$ref": "#/$defs/stringArray" }
      }
    },
    "materiality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changes_project_state", "creates_external_effect",
        "consumes_significant_resources", "expands_authority",
        "changes_security_or_privacy_posture", "difficult_to_reverse"
      ],
      "properties": {
        "changes_project_state": { "type": "boolean" },
        "creates_external_effect": { "type": "boolean" },
        "consumes_significant_resources": { "type": "boolean" },
        "expands_authority": { "type": "boolean" },
        "changes_security_or_privacy_posture": { "type": "boolean" },
        "difficult_to_reverse": { "type": "boolean" }
      }
    },
    "reversibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "limitations"],
      "properties": {
        "level": { "enum": ["full", "partial", "none"] },
        "mechanism": { "$ref": "#/$defs/nonEmptyString" },
        "limitations": { "$ref": "#/$defs/stringArray" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "level": { "enum": ["full", "partial"] } },
            "required": ["level"]
          },
          "then": { "required": ["mechanism"] }
        }
      ]
    },
    "authorizationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grantor", "grantee", "action_kind", "target", "environment",
        "conditions", "valid_at"
      ],
      "properties": {
        "grantor": { "$ref": "#/$defs/nonEmptyString" },
        "grantee": { "$ref": "#/$defs/nonEmptyString" },
        "action_kind": { "$ref": "#/$defs/nonEmptyString" },
        "target": { "$ref": "#/$defs/nonEmptyString" },
        "environment": { "$ref": "#/$defs/nonEmptyString" },
        "conditions": { "$ref": "#/$defs/stringArray" },
        "valid_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unmapped_events", "assumptions", "indeterminate_properties"],
      "properties": {
        "unmapped_events": { "$ref": "#/$defs/stringArray" },
        "assumptions": { "$ref": "#/$defs/stringArray" },
        "indeterminate_properties": { "$ref": "#/$defs/stringArray" }
      }
    }
  }
}
