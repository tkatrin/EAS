{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eas.example/schemas/eas-corpus/0.1.0",
  "title": "EAS 0.1 Behavioral Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["eas_version", "corpus_version", "corpus_id", "title", "scenarios"],
  "properties": {
    "eas_version": { "const": "0.1" },
    "corpus_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "corpus_id": { "$ref": "#/$defs/nonEmptyString" },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenarioEntry" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "scenarioEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "group", "task_class", "stimulus", "initial_state",
        "constraints", "controlled_failure_mode", "requirement_refs",
        "required_artifacts", "status"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^SCN-[0-9]{3}$" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "group": {
          "enum": ["scope", "ambiguity", "verification", "authority", "research_advice", "ml_data_science"]
        },
        "task_class": {
          "enum": ["change", "diagnose", "review", "research", "operate", "advise"]
        },
        "stimulus": { "$ref": "#/$defs/nonEmptyString" },
        "initial_state": { "$ref": "#/$defs/nonEmptyString" },
        "constraints": { "$ref": "#/$defs/stringArray" },
        "controlled_failure_mode": { "$ref": "#/$defs/nonEmptyString" },
        "requirement_refs": { "$ref": "#/$defs/stringArray" },
        "required_artifacts": { "$ref": "#/$defs/stringArray" },
        "status": { "enum": ["executable", "definition_only"] },
        "manifest": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
