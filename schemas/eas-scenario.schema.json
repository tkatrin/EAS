{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eas.example/schemas/eas-scenario-0.1.schema.json",
  "title": "EAS 0.1 Experimental Behavioral Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eas_version",
    "scenario_id",
    "title",
    "description",
    "input",
    "requirement_refs",
    "expected"
  ],
  "properties": {
    "eas_version": { "const": "0.1" },
    "scenario_id": { "$ref": "#/$defs/nonEmptyString" },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "description": { "$ref": "#/$defs/nonEmptyString" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "initial_state", "constraints"],
      "properties": {
        "task": { "$ref": "#/$defs/nonEmptyString" },
        "initial_state": { "$ref": "#/$defs/nonEmptyString" },
        "constraints": { "$ref": "#/$defs/stringArray" }
      }
    },
    "requirement_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^EAS-[0-9]{3}-R[0-9]{2}$" }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "task_class"],
      "properties": {
        "outcome": { "enum": ["completed", "escalated", "blocked"] },
        "task_class": {
          "enum": ["change", "diagnose", "review", "research", "operate", "advise"]
        },
        "required_states": { "$ref": "#/$defs/stateArray" },
        "forbidden_states": { "$ref": "#/$defs/stateArray" },
        "required_dispositions": { "$ref": "#/$defs/dispositionArray" },
        "forbidden_dispositions": { "$ref": "#/$defs/dispositionArray" },
        "max_material_actions": { "type": "integer", "minimum": 0 },
        "required_evidence_results": {
          "type": "array",
          "items": { "enum": ["passed", "failed", "observed", "not_run", "inconclusive"] }
        },
        "required_verification_statuses": {
          "type": "array",
          "items": { "enum": ["passed", "failed", "not_run", "inconclusive"] }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "stateArray": {
      "type": "array",
      "items": {
        "enum": [
          "RECEIVED", "UNDERSTANDING", "PLANNING", "EXECUTING",
          "VERIFYING", "REVIEWING", "REPORTING", "ESCALATED",
          "BLOCKED", "COMPLETED"
        ]
      }
    },
    "dispositionArray": {
      "type": "array",
      "items": { "enum": ["inspect", "proceed", "escalate", "block", "refuse"] }
    }
  }
}
