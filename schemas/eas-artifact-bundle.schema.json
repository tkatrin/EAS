{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eas.example/schemas/eas-artifact-bundle/0.1.0",
  "title": "EAS 0.1 External Artifact Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_version", "run_id", "created_at", "artifacts"],
  "properties": {
    "bundle_version": { "const": "0.1.0" },
    "run_id": { "$ref": "#/$defs/nonEmptyString" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "description", "path", "sha256", "byte_length",
        "capture", "source", "evidence_refs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "byte_length": { "type": "integer", "minimum": 0 },
        "capture": { "enum": ["direct", "imported", "self_reported"] },
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    }
  }
}
