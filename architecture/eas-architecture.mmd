    EX --> V["Verify"]
    V --> Q{"Quality Review"}
    Q -->|"insufficient"| U
    Q -->|"replan"| PL
    Q -->|"adequate"| R["Truthful Report"]
    R --> O["New Project State + Outcome + Task Result + Evidence"]

    EV["Evidence"] -. supports .-> U
    EV -. supports .-> D
    EV -. supports .-> V
    EV -. supports .-> Q
    EV -. supports .-> R
