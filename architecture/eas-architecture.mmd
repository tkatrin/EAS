flowchart TD
    T["Engineering Task"] --> U["Understanding"]
    P0["Initial Project State"] --> U
    C["Context and Constraints"] --> U
    U --> D{"Decision and Autonomy Gate"}
    D -->|"authorized"| L["Lifecycle Control"]
    D -->|"needs direction"| E1["Escalated"]
    D -->|"cannot proceed"| B["Blocked"]
    L --> PL["Plan"]
